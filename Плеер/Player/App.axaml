<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Player.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Themes.Fluent/FluentTheme.axaml"/>
    </Application.Styles>

    <Application.Resources>
        <FontFamily x:Key="InterFont">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
        
        <!-- Override System Accent Colors to Kill Pink -->
        <Color x:Key="SystemAccentColor">#3A86FF</Color>
        <Color x:Key="SystemAccentColorDark1">#2A66CC</Color>
        <Color x:Key="SystemAccentColorDark2">#1A4699</Color>
        <Color x:Key="SystemAccentColorDark3">#0A2666</Color>
        <Color x:Key="SystemAccentColorLight1">#5B9DFF</Color>
        <Color x:Key="SystemAccentColorLight2">#7CB4FF</Color>
        <Color x:Key="SystemAccentColorLight3">#9DCAFF</Color>
        
        <!-- Custom Vector Icons Data -->
        <StreamGeometry x:Key="IconPlay">M8,5.14V19.14L19,12.14L8,5.14Z</StreamGeometry>
        <StreamGeometry x:Key="IconPause">M14,19H18V5H14M6,19H10V5H6V19Z</StreamGeometry>
        <StreamGeometry x:Key="IconNext">M6,18L14.5,12L6,6M16,6V18H18V6</StreamGeometry>
        <StreamGeometry x:Key="IconPrev">M18,6L9.5,12L18,18M8,18V6H6V18</StreamGeometry>
        <StreamGeometry x:Key="IconRepeat">M17,17H7V14L3,18L7,22V19H19V13H17M7,7H17V10L21,6L17,2V5H5V11H7V7Z</StreamGeometry>
        <StreamGeometry x:Key="IconShuffle">M14.83,13.41L13.42,14.82L16.55,17.95L14.5,20H20V14.5L17.96,16.54L14.83,13.41M14.5,4L16.54,6.04L4,18.59L5.41,20L17.96,7.46L20,9.5V4H14.5M10.59,9.17L5.41,4L4,5.41L9.17,10.58L10.59,9.17Z</StreamGeometry>
        <StreamGeometry x:Key="IconAutoPlay">M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M10,17L15,12L10,7V17Z</StreamGeometry>
        <StreamGeometry x:Key="IconSearch">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</StreamGeometry>
    </Application.Resources>
</Application>
